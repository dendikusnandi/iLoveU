#!/bin/bash

# Variables
# 2 curl di awal (icanhazip + tanggal google) dibuang: hasilnya tidak pernah
# dipakai, hanya membuat pembuatan akun menunggu jaringan.
ip=$(cat /etc/xray/ip 2>/dev/null)
[ -z "$ip" ] && ip=$(wget -qO- --timeout=5 ipv4.icanhazip.com 2>/dev/null)
city=$(cat /etc/xray/city 2>/dev/null || echo "Unknown city")
pubkey=$(cat /etc/slowdns/server.pub 2>/dev/null || echo "Pubkey not available")
domain=$(cat /etc/xray/domain 2>/dev/null || hostname -f)

clear

[ -f /etc/ssh/.ssh.db ] || { mkdir -p /etc/ssh; touch /etc/ssh/.ssh.db; }

while true; do
    read -r -p "   Name: " user
    # Pesan error dulu selalu "cannot be empty" walau sebabnya lain.
    # Username angka saja lolos regex tapi DITOLAK useradd ("invalid user
    # name: use --badname") -> dulu akun gagal dibuat tapi tetap dicatat.
    if [[ -z "$user" ]]; then
        printf "\033[1A\033[0J"
        echo -e "${red}   Username cannot be empty${reset}"
        continue
    elif [[ ${#user} -lt 3 ]]; then
        printf "\033[1A\033[0J"
        echo -e "${red}   Username minimal 3 karakter${reset}"
        continue
    elif [[ ${#user} -gt 32 ]]; then
        printf "\033[1A\033[0J"
        echo -e "${red}   Username maksimal 32 karakter${reset}"
        continue
    elif [[ ! "$user" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
        printf "\033[1A\033[0J"
        echo -e "${red}   Username harus huruf kecil/underscore di awal, lalu huruf/angka/_/-${reset}"
        continue
    fi
    # Cek duplikat di .ssh.db DAN /etc/passwd. Dulu hanya .ssh.db, jadi
    # username yang sudah ada di sistem membuat useradd gagal diam-diam.
    if grep -q "^### $user " /etc/ssh/.ssh.db || id "$user" >/dev/null 2>&1; then
        random_number=$(head /dev/urandom | tr -dc a-z0-9 | head -c 5)
        user="${random_number}${user}"
        echo -e "${yellow}   Username already exists. New username used: $user${reset}"
        break
    else
        break
    fi
done
echo ""
echo -e "—————————————————————————————————————"
echo "   Username : $user"
while true; do
    # -s: password tidak ditampilkan saat diketik, supaya tidak terbaca orang
    # di sekitar dan tidak tertinggal di scrollback terminal.
    read -r -s -p "   Password: " passwd
    echo ""
    if [[ -z "$passwd" ]]; then
        echo -e "${red}   Password cannot be empty${reset}"
    else
        break
    fi
done

while true; do
    read -r -p "   Active period (days): " expired
    if [[ -z "$expired" ]]; then
        echo -e "${red}   Active period cannot be empty${reset}"
    elif ! [[ $expired =~ ^[0-9]+$ ]]; then
        echo -e "${red}   Active period must be a number${reset}"
    elif [[ $expired -lt 1 ]]; then
        echo -e "${red}   Active period must be at least 1 day${reset}"
    else
        break
    fi
done

while true; do
    read -r -p "   IP limit: " iplim
    if [[ -z "$iplim" ]]; then
        echo -e "${red}   IP limit cannot be empty${reset}"
    elif ! [[ $iplim =~ ^[0-9]+$ ]]; then
        echo -e "${red}   IP limit must be a number${reset}"
    elif [[ $iplim -lt 1 ]]; then
        echo -e "${red}   IP limit must be at least 1${reset}"
    else
        break
    fi
done

# Account creation process
# Dulu exit code useradd/passwd tidak pernah dicek: kalau useradd gagal
# (username tidak valid / sudah ada), skrip tetap menulis ke .ssh.db dan
# menampilkan "akun berhasil" -> pelanggan dapat detail untuk akun yang
# tidak ada di sistem dan tidak bisa login sama sekali.
exp_date=$(date -d "$expired days" +"%Y-%m-%d")
if ! useradd -e "$exp_date" -s /bin/false -M "$user" 2>/tmp/.addssh_err; then
    clear
    echo -e "${red}—————————————————————————————————————${reset}"
    echo -e "${red}   GAGAL MEMBUAT AKUN${reset}"
    echo -e "${red}—————————————————————————————————————${reset}"
    echo -e "   Username : $user"
    echo -e "   Alasan   : $(cat /tmp/.addssh_err 2>/dev/null | head -1)"
    echo -e "${red}—————————————————————————————————————${reset}"
    rm -f /tmp/.addssh_err
    exit 1
fi
rm -f /tmp/.addssh_err

# `echo -e` menerjemahkan backslash: password "pa\ttest" jadi "pa<TAB>test",
# sehingga pelanggan tidak bisa login dengan password yang dia terima.
# chpasswd membaca apa adanya.
if ! echo "$user:$passwd" | chpasswd 2>/dev/null; then
    userdel -f "$user" 2>/dev/null
    clear
    echo -e "${red}   GAGAL menetapkan password — akun dibatalkan.${reset}"
    exit 1
fi
exp="$(chage -l "$user" 2>/dev/null | grep "Account expires" | awk -F": " '{print $2}')"

if [[ $iplim != "0" ]]; then
    echo "${iplim}" >/etc/ssh/${user}
    chmod 600 "/etc/ssh/${user}"
fi
echo "### ${user} ${exp_date}" >>/etc/ssh/.ssh.db

# Backup .ssh.db tiap kali berubah — kalau file rusak/terhapus, seluruh
# catatan akun (limit IP, riwayat) hilang; chage hanya menyimpan expiry.
mkdir -p /etc/ssh/backup
cp -f /etc/ssh/.ssh.db "/etc/ssh/backup/.ssh.db.$(date +%Y%m%d)" 2>/dev/null
chmod 600 /etc/ssh/backup/.ssh.db.* 2>/dev/null
ls -1t /etc/ssh/backup/.ssh.db.* 2>/dev/null | tail -n +8 | xargs -r rm -f

mkdir -p /var/www/html

# Nama file config diberi token acak. Sebelumnya path-nya bisa ditebak
# (ssh-<username>.txt) sementara nginx menyajikan /var/www/html di port 81
# ke 0.0.0.0 — siapa pun yang menebak username bisa mengunduh PASSWORD
# pelanggan. Token 16 hex membuat URL tidak bisa ditebak, dan file lama
# milik user yang sama dibuang lebih dulu.
rm -f /var/www/html/ssh-${user}.txt /var/www/html/ssh-${user}-*.txt
cfg_token=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
cfg_name="ssh-${user}-${cfg_token}.txt"

# Create configuration file
cat >/var/www/html/${cfg_name} <<END
---------------------
SSH OVPN Account Details
---------------------
Username         : $user
Password         : $passwd
---------------------
IP               : $ip
Host             : $domain
Public Key       : ${pubkey}
Location         : $city
OpenSSH Port     : 443, 80, 22
UdpSSH Port      : 1-65535
Dropbear Port    : 443, 109
Dropbear WS Port : 443, 109
SSH WS Port      : 80
SSH SSL WS Port  : 443
SSL/TLS Port     : 443
OVPN WS SSL Port : 443
OVPN SSL Port    : 443
OVPN TCP Port    : 443, 1194
OVPN UDP Port    : 2200
BadVPN UDP       : 7100, 7300, 7300
---------------------
WSS Payload: GET wss://BUG.COM/ HTTP/1.1[crlf]Host: $domain[crlf]Upgrade: websocket[crlf][crlf] 
---------------------
OpenVPN Link     : http://$domain:85
---------------------
Expiration       : $expired
END
chmod 644 /var/www/html/${cfg_name}



# Save log
{
    echo "───────────────────────────"
    echo "     SSH OVPN Account     "
    echo "───────────────────────────"
    echo "Username         : $user"
    echo "Password         : $passwd"
    echo "───────────────────────────"
    echo "IP               : $ip"
    echo "Host             : $domain"    
    echo "Location         : $city"
    echo "OpenSSH Port     : 443, 80, 22"
    echo "UdpSSH Port      : 1-65535"
    echo "DNS Port         : 443, 53, 22"
    echo "Dropbear Port    : 443, 109"
    echo "SSH WS Port      : 80, 8080"
    echo "SSH SSL WS Port  : 443"
    echo "SSL/TLS Port     : 443"
    echo "OVPN SSL Port    : 443"
    echo "OVPN TCP Port    : 1194"
    echo "OVPN UDP Port    : 2200"
    echo "Squid Proxy      : 3128"
    echo "BadVPN UDP       : 7100, 7300, 7300"
    echo "SlowDns Public Key: ${pubkey}"
    echo "───────────────────────────"
    echo "WSS Payload      : GET wss://BUG.COM/ HTTP/1.1[crlf]Host: $domain[crlf]Upgrade: websocket[crlf][crlf]"
    echo "───────────────────────────"
    echo "OpenVPN Link     : https://$domain:81/allovpn.zip"
    echo "───────────────────────────"
    echo "Save Account Link: https://$domain:81/${cfg_name}"
    echo "───────────────────────────"
    echo "Expiration       : $expired"
    echo ""
} >>/etc/xray/log-createssh-${user}.log

clear
echo -e "—————————————————————————————————————"
echo -e "     SSH OVPN Account      "
echo -e "───────────────────────────"
echo -e "Username         : $user"
echo -e "Password         : $passwd"
echo -e "—————————————————————————————————————"
echo -e "IP               : $ip"
echo -e "Host             : $domain"
echo -e "Location         : $city"
echo -e "OpenSSH Port     : 443, 80, 22"
echo -e "UdpSSH Port      : 1-65535"
echo -e "DNS Port         : 443, 53, 22"
echo -e "Dropbear Port    : 443, 109"
echo -e "SSH WS Port      : 80"
echo -e "SSH SSL WS Port  : 443"
echo -e "SSL/TLS Port     : 443"
echo -e "OVPN SSL Port    : 443"
echo -e "OVPN TCP Port    : 1194"
echo -e "OVPN UDP Port    : 2200"
echo -e "BadVPN UDP       : 7100, 7300, 7300"
echo -e "SlowDns Public Key: ${pubkey}"
echo -e "—————————————————————————————————————"
echo -e "WSS Payload      : GET wss://BUG.COM/ HTTP/1.1[crlf]Host: $domain[crlf]Upgrade: websocket[crlf][crlf]"
echo -e "—————————————————————————————————————"
echo -e "OpenVPN Link     : https://$domain:81/allovpn.zip"
echo -e "—————————————————————————————————————"
echo -e "Save Account Link: https://$domain:81/${cfg_name}"
echo -e "—————————————————————————————————————"
echo -e "Expiration       : $expired"
echo -e ""
