# Dulu menu memanggil 4 request tiap kali dibuka (icanhazip, google date,
# ipinfo org, ipinfo city) sehingga terasa lambat 2-3 detik. Nilai-nilai itu
# tidak berubah, dan setup.sh sudah menyimpannya di /etc/xray/. Baca file
# saja; curl hanya dipakai sebagai cadangan kalau cache belum ada.
ipsaya=$(cat /etc/xray/ip 2>/dev/null)
[ -z "$ipsaya" ] && {
    ipsaya=$(curl -sS --max-time 5 ipv4.icanhazip.com 2>/dev/null)
    [ -n "$ipsaya" ] && echo "$ipsaya" >/etc/xray/ip
}
